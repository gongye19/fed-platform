FEDPLAT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
FEDPLAT_ADMIN_TOKEN=replace-with-at-least-24-random-characters
FEDPLAT_ADMIN_AUTH_DISABLED=false

FEDPLAT_S3_ENDPOINT=https://s3-compatible-endpoint.example
