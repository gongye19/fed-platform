FEDPLAT_S3_ACCESS_KEY_ID=replace-me
FEDPLAT_S3_SECRET_ACCESS_KEY=replace-me
FEDPLAT_S3_URL_STYLE=virtual

FEDPLAT_MAX_ARTIFACT_BYTES=536870912
FEDPLAT_CORS_ORIGINS=http://localhost:5173

DEEPSEEK_API_KEY=replace-me
